{
  "regions": ["sin1"],
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index?route=$1" }],
  "headers": [
    {
      "source": "/(.*)\\.pdf",
      "headers": [{ "key": "Content-Disposition", "value": "attachment; filename=\"Freshroots_Components_Map.pdf\"" }]
    }
  ],
  "functions": {
    "api/index.py": { "includeFiles": "{engine.py,approve.py,ops.py,config.json}", "maxDuration": 30 }
  }
}
